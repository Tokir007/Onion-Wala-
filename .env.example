# ==============================================================================
# Onion Wala Environment Configuration
# ==============================================================================

# Supabase Credentials (from your Supabase project dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Service Role Key for administrative operations if needed
SUPABASE_SERVICE_ROLE_KEY=

# Mandi Rates API (Optional: data.gov.in Agmarknet API Key)
# If left empty, the server automatically fetches live publicly accessible commodity rates
# or gracefully falls back to the latest recorded mandi rates with a clear indicator.
DATA_GOV_API_KEY=
